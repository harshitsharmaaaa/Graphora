  },
  "devDependencies": {
    "@eraser/config": "workspace:*",
    "@eraser/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
