{
  "name": "@eraser/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .vite *.tsbuildinfo"
  },
  "dependencies": {
    "@eraser/editor-core": "workspace:*",
    "@eraser/editor-elements": "workspace:*",
    "@eraser/editor-geometry": "workspace:*",
    "@eraser/editor-history": "workspace:*",
    "@eraser/editor-renderer": "workspace:*",
    "@eraser/editor-tools": "workspace:*",
    "@eraser/realtime": "workspace:*",
    "@eraser/shared-types": "workspace:*",
    "@eraser/shared-validation": "workspace:*",
    "@eraser/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eraser/config": "workspace:*",
    "@eraser/tsconfig": "workspace:*",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
