# =============================================================================
# Shared placeholders — copy to `.env` for local development. Never commit `.env`.
#
# PUBLIC_* variables are browser-safe. DATABASE_URL and AI credentials are
# server-only and must never use a Vite-exposed prefix.
# =============================================================================

PUBLIC_API_URL=http://localhost:3001
PUBLIC_WEB_PORT=5173

SERVER_PORT=3001
SERVER_HOST=0.0.0.0
SERVER_CORS_ORIGINS=http://localhost:5173
SERVER_LOG_LEVEL=info

# Better Auth server-only configuration.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only Neon/PostgreSQL connection strings.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Server-only AI configuration. Set AI_PROVIDER=google for Gemini.
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
