# =============================================================================
# Shared placeholders — copy to `.env` for local development. Never commit `.env`.
#
# Convention:
#   PUBLIC_*  -> safe to expose to the browser (Vite only exposes allowlisted
#                prefixes, see apps/frontend/vite.config.ts `envPrefix`).
#   SERVER_*  -> backend-only. NEVER read these from apps/frontend.
# =============================================================================

# --- Frontend (read via import.meta.env in apps/frontend) ---
# Base URL of the API used by the web app.
PUBLIC_API_URL=http://localhost:3001
# Optional: override the web dev-server port.
PUBLIC_WEB_PORT=5173

# --- Backend (read via process.env in apps/backend, see src/lib/env.ts) ---
SERVER_PORT=3001
SERVER_HOST=0.0.0.0
# Comma-separated origins allowed for CORS (future use, currently permissive localhost).
SERVER_CORS_ORIGINS=http://localhost:5173
SERVER_LOG_LEVEL=info
