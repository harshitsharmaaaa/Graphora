# =============================================================================
# Shared placeholders — copy to `.env` for local development. Never commit `.env`.
#
# PUBLIC_* variables are browser-safe. DATABASE_URL and AI credentials are
# server-only and must never use a Vite-exposed prefix.
# =============================================================================

PUBLIC_API_URL=http://localhost:3001
PUBLIC_REALTIME_URL=ws://localhost:3001/ws/collaboration
PUBLIC_WEB_PORT=5173

SERVER_PORT=3001
SERVER_HOST=0.0.0.0
SERVER_CORS_ORIGINS=http://localhost:5173
SERVER_LOG_LEVEL=info
SERVER_WEBSOCKET_PATH=/ws/collaboration
SERVER_REALTIME_SNAPSHOT_DEBOUNCE_MS=750
SERVER_REALTIME_IDLE_ROOM_MS=60000
SERVER_REALTIME_MAX_CLIENTS_PER_ROOM=100
SERVER_REALTIME_MAX_USERS_PER_ROOM=100
SERVER_REALTIME_MAX_ROOMS=1000
SERVER_REALTIME_MAX_CONNECTIONS=2000
SERVER_REALTIME_MAX_AWARENESS_ENTRIES=100
SERVER_REALTIME_MAX_UPDATE_BYTES=5242880

# Better Auth server-only configuration.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only Neon/PostgreSQL connection strings.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Server-only AI configuration. Set AI_PROVIDER=google for Gemini.
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
